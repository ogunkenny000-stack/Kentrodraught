# Browser values are public and compiled into the production client at build time.
VITE_SUPABASE_URL=""
VITE_SUPABASE_PUBLISHABLE_KEY=""

# Runtime server bindings. Enter secrets in the hosting secret manager.
SUPABASE_URL=""
SUPABASE_SECRET_KEY=""
APP_URL=""

# Optional first-admin provisioning: an existing authenticated user's UUID.
BOOTSTRAP_ADMIN_UID=""

# Game archives and sequence state; mount this exact directory persistently.
KENTRO_DATA_DIR="./data"
HOST="0.0.0.0"
PORT="3000"

# Keep startup database changes disabled. Rehearse ordered SQL migrations in staging.
SKIP_DB_MIGRATION="1"
# A direct PostgreSQL connection is needed only for deliberately opted-in repair.
SUPABASE_DB_URL=""

# Enable only behind the local Go edge with the backend bound to loopback.
# TRUST_PROXY="loopback"

# Optional HTTPS push. Generate VAPID keys locally; never commit the private key.
WEB_PUSH_VAPID_PUBLIC_KEY=""
WEB_PUSH_VAPID_PRIVATE_KEY=""
WEB_PUSH_CONTACT="mailto:support@your-domain.example"

# The core Ken engine is native and requires no Gemini API key.
# The optional experimental training lab accepts an operator's own key in its UI.
# Do not compile private provider credentials into VITE_* variables.

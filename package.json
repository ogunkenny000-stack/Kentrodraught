{
  "name": "kentro-draughts",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "postinstall": "node scripts/build-engine.cjs",
    "prebuild": "node scripts/build-engine.cjs",
    "build": "vite build && node scripts/inject-sw-assets.cjs && node scripts/precompress-assets.cjs && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "build:engine": "node scripts/build-engine.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "build:edge": "cd go-edge && go build -trimpath -ldflags=\"-s -w\" -o ../dist/kentro-edge .",
    "test:edge": "cd go-edge && go test ./...",
    "test:perf": "node scripts/performance-smoke.cjs && node --experimental-strip-types scripts/engine-mutex-smoke.mjs",
    "migrations:check": "node scripts/build-migrations.cjs --check",
    "migrations:build": "node scripts/build-migrations.cjs",
    "test:database": "tsx scripts/audit/database-security.mjs",
    "test:multiplayer": "tsx scripts/audit/multiplayer-smoke.ts",
    "test:browser": "tsx scripts/e2e/frontend.e2e.ts",
    "test:tv": "tsx scripts/e2e/tv.e2e.ts",
    "test:offline": "tsx scripts/e2e/offline.e2e.ts",
    "test:nearby": "tsx scripts/e2e/nearby.e2e.ts",
    "test:container": "tsx scripts/audit/container-smoke.ts",
    "test:restart": "tsx scripts/audit/live-restart.ts",
    "test:tournaments": "tsx scripts/audit/tournament-smoke.ts",
    "test:groups": "tsx scripts/e2e/groups.e2e.ts",
    "test:hosted": "node scripts/audit/hosted-supabase.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.17.1",
    "@supabase/supabase-js": "^2.110.0",
    "compression": "^1.8.1",
    "express": "^4.21.2",
    "glicko2": "^1.2.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pg": "^8.13.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/compression": "^1.8.1",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "axe-core": "^4.14.0",
    "esbuild": "^0.25.0",
    "puppeteer-core": "^25.14.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vitest": "^4.1.10"
  }
}
